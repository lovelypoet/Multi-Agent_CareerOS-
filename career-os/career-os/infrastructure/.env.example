# ---------------------------------------------------------------------------
# Copy file này thành backend/.env rồi điền giá trị thật. KHÔNG commit file .env.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# Phải dùng driver asyncpg (app và Alembic đều chạy async).
DATABASE_URL=postgresql+asyncpg://careeros:careeros@localhost:5432/careeros

# --- LLM provider -------------------------------------------------------------
# matching_agent dùng provider nào — đổi qua lại chỉ bằng sửa dòng này, không sửa code.
# "anthropic" (mặc định, trả phí, ổn định) | "ollama" (1 model local, miễn phí, cần đã
# `ollama pull qwen2.5:7b`) | "ollama_ensemble" (2 model local kiểm tra chéo, cần thêm
# `ollama pull llama3.1:8b` — xem docs/hybrid-model-journey.md để biết lý do và số liệu).
LLM_PROVIDER=anthropic

# --- Anthropic --------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=2000
ANTHROPIC_TIMEOUT_SECONDS=90

# --- Ollama (local model, chỉ cần nếu LLM_PROVIDER=ollama/ollama_ensemble) ---
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_HOST=http://localhost:11434
# Model thứ 2, chỉ dùng khi LLM_PROVIDER=ollama_ensemble — cố ý khác kiến trúc với
# OLLAMA_MODEL (Qwen vs Llama) để kiểm tra chéo có ý nghĩa.
OLLAMA_SECONDARY_MODEL=llama3.1:8b

# --- App --------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
RESUME_SINGLETON_ID=1

# --- Phase 1: fetch job tự động (ITviec) -------------------------------------
# Giờ chạy hàng ngày (giờ server). Mặc định 8:00 sáng nếu bỏ trống.
FETCH_JOBS_HOUR=8
FETCH_JOBS_MINUTE=0

# --- Phase 2: dashboard -------------------------------------------------------
# "jobs_today" trên dashboard tính theo múi giờ này, không theo UTC của server.
DASHBOARD_TIMEZONE=Asia/Ho_Chi_Minh

# --- Dùng cho docker-compose (không phải backend đọc) -----------------------
POSTGRES_USER=careeros
POSTGRES_PASSWORD=careeros
POSTGRES_DB=careeros
POSTGRES_PORT=5432
